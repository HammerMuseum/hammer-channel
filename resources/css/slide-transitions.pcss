.slide-down-enter-active,
.slide-down-leave-active {
  transition: transform var(--overlay-transition);
}

.slide-down-enter-from {
  transform: translateY(-100%);
}

.slide-down-enter-to,
.slide-down-leave-from {
  transform: translateY(0);
}

.slide-down-leave-to {
  transform: translateY(-100%);
}
